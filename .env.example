# Real values live in ~/.config/counter/.env (override with COUNTER_ENV_FILE). Names only here.
ARMORIQ_API_KEY=
ARMORIQ_LOGIN=
GEMINI_API_KEY=
OWNER_PASSWORD=
MCP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
# ArmorTools workspace backend (tools.armoriq.ai reads this one); not secret
BACKEND_ENDPOINT=https://staging-api.armoriq.io
ARMORIQ_AGENT_ID=counter-front-desk
# MCP_PUBLIC=1 serves /mcp for ArmorIQ's MCP registry (bearer derived from MCP_TOKEN)
# ARMORIQ_TELEMETRY=0 turns off the console telemetry
